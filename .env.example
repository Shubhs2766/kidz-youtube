# Copy to .env and fill in credentials. Never put real secrets here.

# Google Gemini API: storyboard, QA, images, Veo video, speech and Lyria music
GEMINI_API_KEY=

# Optional email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional Telegram notifications (disabled by default)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
